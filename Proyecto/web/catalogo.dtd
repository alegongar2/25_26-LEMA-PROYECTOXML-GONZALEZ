<!ELEMENT tiendaMusica (infoTienda, catalogo)>

<!ELEMENT infoTienda (nombre, direccion, telefono*, email)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT direccion (#PCDATA)>
<!ELEMENT telefono (#PCDATA)>
<!ELEMENT email (#PCDATA)>

<!ELEMENT catalogo (categoria+)>

<!ELEMENT categoria (producto+)>
<!ATTLIST categoria
    id ID #REQUIRED
    nombre CDATA #REQUIRED
>

<!ELEMENT producto (nombre, artista, precio, descuento?, imagen, url)>

<!ATTLIST producto
    id ID #REQUIRED
    tipo CDATA #IMPLIED
    disponible (bai|ez) "bai"
>

<!ELEMENT artista (#PCDATA)>
<!ELEMENT precio (#PCDATA)>
<!ELEMENT descuento (#PCDATA)>
<!ELEMENT imagen (#PCDATA)>
<!ELEMENT url (#PCDATA)>